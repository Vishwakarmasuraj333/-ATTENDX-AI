# AttendX AI Production Environment Configuration Example
# Copy this file to .env and configure strong random secrets

ENVIRONMENT=production
PROJECT_NAME="AttendX AI"
PROJECT_VERSION="2.0.0"

# Application Security (Generate using: openssl rand -hex 32)
SECRET_KEY=CHANGE_THIS_TO_A_CRYPTOGRAPHICALLY_SECURE_RANDOM_SECRET_KEY_MIN_32_CHARS
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Biometric Encryption Key (Fernet 32 url-safe base64-encoded bytes)
# Generate using Python: from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())
BIOMETRIC_ENCRYPTION_KEY=CHANGE_THIS_TO_A_VALID_FERNET_BASE64_KEY_DO_NOT_COMMIT

# Database Connection (e.g., PostgreSQL for production, or SQLite for local staging)
DATABASE_URL=sqlite:///./attendx.db

# Face Recognition Calibration
FACE_MATCH_THRESHOLD=0.65
FACE_LIVENESS_THRESHOLD=0.70
MIN_FACE_SIZE=80
MIN_IMAGE_QUALITY_SCORE=0.60
